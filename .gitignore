# Ignore everything in the project root by default.
/*

# Keep the files required to build and publish the package.
!/.gitignore
!/examples/
!/examples/**
!/src/
!/src/**
!/LICENSE.txt
!/MANIFEST.in
!/pyproject.toml
!/README.md

# Ignore generated Python artifacts inside the source tree.
**/__pycache__/
*.py[cod]
*.egg-info/
